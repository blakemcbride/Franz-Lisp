#!/bin/sh
# bin/liszt -- launcher for the Lisp compiler.
#
# Same shape as bin/lisp, but feeds liszt-init.l (which loads the
# standard library AND the cliszt compiler source) before the user's
# stdin. Command-line args are forwarded to rawlisp's argv so the
# `lisztinit` top-level hook can pick them up via (command-line-args)
# and run the compile.
#
# Usage:
#   bin/liszt foo.l                 # compile foo.l, exit
#   bin/liszt -q -O foo.l           # with flags (see man/liszt.1)
#   bin/liszt                       # interactive: compiler loaded,
#                                   #   normal Lisp prompt

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT="${FRANZ_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# rawlisp is built in franz/<target>/, where <target> is what
# ./lispconf wrote into lconf.h (`#define macos_arm64 1', ...).
MACH=$(sed -n 's/^#define \([a-z0-9_]*\) 1$/\1/p' "${ROOT}/franz/h/lconf.h" 2>/dev/null || true)
RAWLISP="${ROOT}/franz/${MACH:-unconfigured}/rawlisp"
INIT="${ROOT}/lisplib/liszt-init.l"

if [ ! -x "$RAWLISP" ]; then
    echo "liszt: rawlisp not found at $RAWLISP" >&2
    echo "       run './lispconf' and 'make rawlisp' first." >&2
    exit 1
fi
if [ ! -f "$INIT" ]; then
    echo "liszt: liszt-init.l not found at $INIT" >&2
    exit 1
fi

LISPLIB="${LISPLIB:-${ROOT}/lisplib}"
CLISZT="${CLISZT:-${ROOT}/cliszt}"
FRANZ_ROOT="${ROOT}"
export LISPLIB CLISZT FRANZ_ROOT

# rawlisp loads $FRANZ_INIT (liszt-init.l) itself, forwarding the
# user's argv. liszt-init.l ends with (reset), which unwinds the
# kernel's initial C-level Ntpl reader back to main's F_RESET frame,
# so the for(EVER) loop in lisp.c re-applies 'top-level -- by now the
# Lisp-side franz-top-level, which calls user-top-level (= lisztinit).
# lisztinit inspects (command-line-args) and either compiles and
# calls (exit 0), or drops to an interactive prompt on the terminal.
#
# With args, stdin is /dev/null so a compile that falls into a break
# loop exits at EOF instead of waiting for the terminal. (Piping
# `cat liszt-init.l - | rawlisp`, as this used to, also left cat
# blocked on the terminal after (exit) until another Return.)
if [ $# -gt 0 ]; then
    FRANZ_INIT="$INIT" exec "$RAWLISP" "$@" < /dev/null
else
    FRANZ_INIT="$INIT" exec "$RAWLISP"
fi
